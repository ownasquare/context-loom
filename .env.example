# Reference only: the Context Loom application does not auto-load this file. Docker Compose may use
# it when copied to .env or passed with --env-file. Export other selected variables explicitly.
# Context Loom is local, offline, and loopback-only by default.
# CONTEXT_LOOM_HOME=/absolute/private/path/context-loom
CONTEXT_LOOM_HOST=127.0.0.1
CONTEXT_LOOM_PORT=8768
CONTEXT_LOOM_LOG_LEVEL=INFO
CONTEXT_LOOM_ALLOW_OUTBOUND=false
CONTEXT_LOOM_RETAIN_MESSAGE_CONTENT=false

# Docker Compose host project. Compose mounts it read-only at /workspace.
# Copy this file to .env, pass --env-file .env.example, or export an absolute path in the shell.
CONTEXT_LOOM_PROJECT=./examples/demo-workspace

# Bounded indexing and short-lived current-process hydration cache.
CONTEXT_LOOM_MAX_FILE_BYTES=2000000
CONTEXT_LOOM_MAX_WORKSPACE_FILES=50000
CONTEXT_LOOM_HYDRATION_CACHE_MAX_ENTRIES=128
CONTEXT_LOOM_HYDRATION_CACHE_TTL_SECONDS=900

# Optional local Ollama-compatible structured compactor. Keep this endpoint on loopback.
# A request must also set use_local_model=true or pass --use-local-model.
CONTEXT_LOOM_OLLAMA_URL=http://127.0.0.1:11434
CONTEXT_LOOM_OLLAMA_MODEL=qwen3:4b

# Optional hydration-aware OpenAI-compatible forwarding. Leave unset unless needed.
# This also requires CONTEXT_LOOM_ALLOW_OUTBOUND=true and an explicit POST /api/v1/proxy call.
# CONTEXT_LOOM_PROXY_UPSTREAM_URL=https://api.openai.com
